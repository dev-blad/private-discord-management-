DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Postgres (Railway/Supabase/Neon etc.)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Role IDs
ADMIN_ROLE_ID=
SUPPORT_ROLE_ID=
BOOSTER_ROLE_ID=

# Optional: fallback if payout_channel_id isn't set via /config
PAYOUT_CHANNEL_ID=

# Only if you still use /accounts, /booster, /gold (Google Sheets)
ENABLE_LEGACY_SHEETS=false
MANAGEMENT_SHEET_ID=

# Automatic payouts (stablecoins). Use a NEW wallet that only holds a few days of payouts.
# Private key of that payout wallet, 0x + 64 hex characters. Never commit this.
PAYOUT_PRIVATE_KEY=
# Optional RPC endpoints (Alchemy/QuickNode). Defaults to public ones.
BASE_RPC_URL=
ETH_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
